{
  "name": "the-bulk-buyers",
  "version": "1.0.0",
  "description": "The Bulk Buyers \u2014 B2B garments & apparel wholesale marketplace",
  "main": "server/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/server.js",
    "dev": "scripts/localdb.sh start && concurrently -n api,web -c yellow,cyan \"node --watch server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "seed": "node server/seed/index.js",
    "test": "node --test server/test/api.test.js server/test/security.test.js",
    "db:start": "scripts/localdb.sh start",
    "db:stop": "scripts/localdb.sh stop",
    "db:status": "scripts/localdb.sh status",
    "db:export": "scripts/export-db.sh"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
