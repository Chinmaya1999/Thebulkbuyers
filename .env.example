# Copy to .env for local development (loaded automatically).
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bulkbuyers
# DATABASE_SSL=true            # for managed Postgres that requires SSL (Neon, Supabase, Render external…)
# JWT_SECRET=                  # optional; otherwise generated once and stored in the database
# First admin (created only if no admin exists). In production a random password is printed once if omitted.
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=choose-a-strong-password
# PUBLIC_URL=https://yourdomain.com   # used in sitemap.xml
# Demo buyers/sellers/orders — on by default in development, off in production unless set.
# SEED_DEMO=true
